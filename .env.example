# ── HoneyForge environment template ──
# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL
POSTGRES_USER=honeyforge
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=honeyforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Center (Control API)
# Async SQLAlchemy URL is assembled from the POSTGRES_* vars by app/config.py,
# but can be overridden here if needed.
# DATABASE_URL=postgresql+asyncpg://honeyforge:change-me-in-prod@postgres:5432/honeyforge
# REDIS_URL=redis://redis:6379/0

# JWT (operator auth) — generate a long random value for real use
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# Honeypot liveness: mark offline if no beacon within this many seconds
HONEYPOT_OFFLINE_TTL_S=120

# Demo operator created by scripts/seed.py (change for anything but local dev)
SEED_OPERATOR_USER=admin
SEED_OPERATOR_PASSWORD=honeyforge-admin

# Enrollment tokens for the seeded honeypots; the honeypot containers use the
# same values to self-enroll. Change for anything but local dev.
SEED_LOW_ENROLL_TOKEN=dev-low-enroll-token
SEED_MEDIUM_ENROLL_TOKEN=dev-medium-enroll-token

# Ports published to the operator's host machine
MGMT_HTTP_PORT=8080
# Public (honeynet-facing) TLS port — the disguised web resource / collector
PUBLIC_HTTPS_PORT=8443
