# High-interaction honeypot host image: base agent + the Docker CLI client, so
# the High honeypot can spawn disposable sandbox containers via the mounted
# Docker socket. Lab-only. Build context is the repo root.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN pip install --upgrade pip && pip install "httpx>=0.27,<0.28" "asyncssh>=2.18,<3"

# Docker CLI client only (not the engine).
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz -o /tmp/d.tgz \
 && tar xzf /tmp/d.tgz -C /usr/local/bin --strip-components=1 docker/docker \
 && rm /tmp/d.tgz \
 && apt-get purge -y curl \
 && apt-get autoremove -y \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY agent/honeyagent /app/honeyagent
COPY honeypots /app/honeypots

CMD ["python", "-m", "honeyagent.main"]
